{
  "name": "discovery-and-inventory",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Discovery & Reconciliation and Inventory modules of the NetSingularity OSS platform, on the NST / Vision Waves design system.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "legacy:bundle": "node scripts/bundle-legacy.mjs",
    "gen:sites": "node scripts/gen-sites.mjs",
    "build:single": "VITE_ROUTER=hash vite build && node scripts/single-file.mjs",
    "test": "node tests/run.mjs",
    "test:unit": "node --test tests/unit/",
    "test:e2e:domains": "node tests/e2e-domains.mjs"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "^1.47.0",
    "typescript": "^5.9.0",
    "vite": "^8.2.0"
  }
}
